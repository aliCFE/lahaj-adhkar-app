      "items": [
        {
          "id": "weather_03",
          "arabicText": "اللَّهُمَّ إِنِّي أَسْأَلُكَ خَيْرَهَا، وَخَيْرَ مَا فِيهَا، وَخَيْرَ مَا أُرْسِلَتْ بِهِ، وَأَعُوذُ بِكَ مِنْ شَرِّهَا، وَشَرِّ مَا فِيهَا، وَشَرِّ مَا أُرْسِلَتْ بِهِ",
          "translation": "دعاء عند هبوب الريح الشديدة.",
          "repeatCount": {"type": "fixed", "n": 1},
          "occasion": "عند هبوب الريح",
          "tags": ["ريح"],
          "sources": [{"sourceName": "صحيح مسلم", "hadithNumber": "899", "authenticity": "sahih"}]
        }
      ]
