    {
      "id": "home",
      "name": "دخول المنزل والخروج منه",
      "items": [
        {
          "id": "home_01",
          "arabicText": "بِسْمِ اللَّهِ وَلَجْنَا، وَبِسْمِ اللَّهِ خَرَجْنَا، وَعَلَى اللَّهِ رَبِّنَا تَوَكَّلْنَا",
          "translation": "يقال عند دخول المنزل، ثم يُسلِّم على أهله.",
          "repeatCount": {"type": "fixed", "n": 1},
          "occasion": "عند دخول المنزل",
          "tags": ["منزل", "بيت", "دخول المنزل"],
          "sources": [{"sourceName": "سنن أبي داود", "hadithNumber": "5096", "authenticity": "hasan"}]
        },
        {
          "id": "home_02",
          "arabicText": "بِسْمِ اللَّهِ، تَوَكَّلْتُ عَلَى اللَّهِ، وَلَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ",
          "translation": "من قالها حين يخرج من بيته قيل له: كُفيت، ووُقيت، وهُديت، وتنحّى عنه الشيطان.",
          "repeatCount": {"type": "fixed", "n": 1},
          "occasion": "عند الخروج من المنزل",
          "tags": ["منزل", "بيت", "الخروج من المنزل"],
          "sources": [{"sourceName": "سنن أبي داود والترمذي", "authenticity": "sahih"}]
        }
      ]
    },
    {
      "id": "bathroom",
      "name": "دخول الخلاء والخروج منه",
      "items": [
        {
          "id": "bathroom_01",
          "arabicText": "بِسْمِ اللَّهِ، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْخُبُثِ وَالْخَبَائِثِ",
          "translation": "استعاذة من الشياطين الذكور والإناث.",
          "repeatCount": {"type": "fixed", "n": 1},
