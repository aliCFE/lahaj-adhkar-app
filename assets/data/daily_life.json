          "tags": ["خلاء", "حمام"],
          "sources": [{"sourceName": "صحيح البخاري ومسلم", "authenticity": "sahih"}]
        },
        {
          "id": "bathroom_02",
          "arabicText": "غُفْرَانَكَ",
          "translation": "طلب المغفرة من الله.",
          "repeatCount": {"type": "fixed", "n": 1},
          "occasion": "عند الخروج من الخلاء",
          "tags": ["خلاء", "حمام"],
          "sources": [{"sourceName": "سنن أبي داود والترمذي وابن ماجه", "authenticity": "hasan"}]
        }
