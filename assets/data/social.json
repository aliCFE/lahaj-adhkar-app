        {
          "id": "social_03",
          "arabicText": "يَهْدِيكُمُ اللَّهُ وَيُصْلِحُ بَالَكُمْ",
          "translation": "رد العاطس على من شمّته بـ 'يرحمك الله'.",
          "repeatCount": {"type": "fixed", "n": 1},
          "occasion": "رد العاطس على المُشمِّت",
